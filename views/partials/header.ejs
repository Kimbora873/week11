<%
  const currentFilter = typeof filter !== "undefined" ? filter : "";
  const currentStats = typeof stats !== "undefined" && stats ? stats : null;
  const currentTitle = typeof pageTitle !== "undefined" ? pageTitle : "일정 및 할 일";
  const enableSearch = typeof showSearch !== "undefined" ? showSearch : false;

  const now = new Date();
  const weekDays = ["일", "월", "화", "수", "목", "금", "토"];
  const headerTodayText = `${now.getFullYear()}년 ${now.getMonth() + 1}월 ${now.getDate()}일 (${weekDays[now.getDay()]})`;
  const completionRate = currentStats && currentStats.total > 0
    ? Math.round((currentStats.done / currentStats.total) * 100)
    : 0;
%>
<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= currentTitle %> — TaskFlow</title>
  <link rel="preconnect" href="https://cdn.jsdelivr.net">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard/dist/web/static/pretendard.css">
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <div class="sidebar-backdrop" id="sidebarBackdrop" aria-hidden="true"></div>

  <div class="app-shell">
    <!-- 왼쪽 사이드바 -->
    <aside class="sidebar" id="appSidebar" aria-label="주 메뉴">
      <div class="sidebar-top">
        <a href="/todos" class="brand">
          <span class="brand-mark" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M9 11l3 3L22 4"></path>
              <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path>
            </svg>
          </span>
          <span class="brand-text">
            <strong>TaskFlow</strong>
            <small>일정 및 할 일 관리</small>
          </span>
        </a>
        <button type="button" class="icon-btn sidebar-close" id="sidebarClose" aria-label="사이드바 닫기">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <path d="M18 6L6 18M6 6l12 12"></path>
          </svg>
        </button>
      </div>

      <div class="sidebar-section">
        <p class="sidebar-label">워크스페이스</p>
        <nav class="sidebar-nav">
          <a href="/todos" class="nav-item <%= currentFilter === 'all' ? 'active' : '' %>">
            <span class="nav-icon" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="8" y1="6" x2="21" y2="6"></line>
                <line x1="8" y1="12" x2="21" y2="12"></line>
                <line x1="8" y1="18" x2="21" y2="18"></line>
                <line x1="3" y1="6" x2="3.01" y2="6"></line>
                <line x1="3" y1="12" x2="3.01" y2="12"></line>
                <line x1="3" y1="18" x2="3.01" y2="18"></line>
              </svg>
            </span>
            <span class="nav-text">전체 일정</span>
            <% if (currentStats) { %>
              <span class="nav-badge"><%= currentStats.total %></span>
            <% } %>
          </a>

          <a href="/todos?filter=active" class="nav-item <%= currentFilter === 'active' ? 'active' : '' %>">
            <span class="nav-icon" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="9"></circle>
                <polyline points="12 7 12 12 15 15"></polyline>
              </svg>
            </span>
            <span class="nav-text">미완료</span>
            <% if (currentStats) { %>
              <span class="nav-badge"><%= currentStats.active %></span>
            <% } %>
          </a>

          <a href="/todos?filter=done" class="nav-item <%= currentFilter === 'done' ? 'active' : '' %>">
            <span class="nav-icon" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                <polyline points="22 4 12 14.01 9 11.01"></polyline>
              </svg>
            </span>
            <span class="nav-text">완료된 일정</span>
            <% if (currentStats) { %>
              <span class="nav-badge"><%= currentStats.done %></span>
            <% } %>
          </a>

          <a href="/todos#calendar" class="nav-item" id="sidebarCalendarLink">
            <span class="nav-icon" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                <line x1="16" y1="2" x2="16" y2="6"></line>
                <line x1="8" y1="2" x2="8" y2="6"></line>
                <line x1="3" y1="10" x2="21" y2="10"></line>
              </svg>
            </span>
            <span class="nav-text">달력 보기</span>
          </a>
        </nav>
      </div>

      <% if (currentStats) { %>
        <div class="sidebar-progress-card">
          <div class="progress-head">
            <span>달성률</span>
            <strong><%= completionRate %>%</strong>
          </div>
          <div class="progress-track" role="progressbar" aria-valuenow="<%= completionRate %>" aria-valuemin="0" aria-valuemax="100">
            <div class="progress-fill" style="width: <%= completionRate %>%"></div>
          </div>
          <p class="progress-caption">총 <%= currentStats.total %>건 중 <%= currentStats.done %>건 완료</p>
        </div>
      <% } %>

      <!-- 좌측 하단 사용자 프로필 카드 -->
      <div class="user-profile-card" aria-label="사용자 정보">
        <img src="/images/avatar.svg" alt="신상민 프로필 사진" class="profile-avatar">
        <div class="profile-info">
          <strong class="profile-name">신상민</strong>
          <span class="profile-id">202008086</span>
        </div>
      </div>

      <div class="sidebar-footer">
        <div class="stack-pill">Express · EJS · MySQL</div>
      </div>
    </aside>

    <!-- 오른쪽 메인 영역 -->
    <div class="workspace-main">
      <header class="top-header">
        <div class="header-left">
          <button type="button" class="icon-btn sidebar-toggle" id="sidebarToggle" aria-label="메뉴 열기" aria-controls="appSidebar" aria-expanded="false">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
              <line x1="3" y1="6" x2="21" y2="6"></line>
              <line x1="3" y1="12" x2="21" y2="12"></line>
              <line x1="3" y1="18" x2="21" y2="18"></line>
            </svg>
          </button>
          <div class="header-title-group">
            <h1><%= currentTitle %></h1>
            <p class="header-date"><%= headerTodayText %></p>
          </div>
        </div>

        <div class="header-actions">
          <% if (enableSearch) { %>
            <label class="search-box" aria-label="일정 검색">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="11" cy="11" r="8"></circle>
                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
              </svg>
              <input type="search" id="todoSearch" placeholder="일정 제목 검색...">
            </label>
            <button type="button" class="btn btn-primary" id="focusNewTodo">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true">
                <line x1="12" y1="5" x2="12" y2="19"></line>
                <line x1="5" y1="12" x2="19" y2="12"></line>
              </svg>
              <span>새 할 일</span>
            </button>
          <% } else { %>
            <a href="/todos" class="btn btn-ghost">목록으로</a>
          <% } %>
        </div>
      </header>

      <main class="main-content">
